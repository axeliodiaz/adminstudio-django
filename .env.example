# Local (DJANGO_ENV=local) uses SQLite unless you point tests/commands at Postgres.
# Production on Render requires DATABASE_URL. Prefer the Supabase session pooler
# (port 5432, user postgres.<project-ref>) so Render can connect over IPv4:
#
# DATABASE_URL=postgresql://postgres.ptnaxlkrlwnldpmfqjzp:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Supabase API (not used by Django ORM; do not put service_role in the frontend):
# SUPABASE_URL=https://ptnaxlkrlwnldpmfqjzp.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
#
# Optional on Render after migrate: LOAD_HEAVY_FIXTURES=1 (large schedule/reservation dumps).
# SKIP_DEMO_FIXTURES=1 skips versioned fixture packs and relies on seed_* only.

# Public frontend origin used in email links (verify, wallet, reservations).
# Local default is Vite; production should be the live studio host.
# FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=https://studio.axeldiaz.com

